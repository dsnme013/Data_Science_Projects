# ═══════════════════════════════════════════════════════════════════════════════
# RESUME INTELLIGENCE PLATFORM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED API KEYS
# ═══════════════════════════════════════════════════════════════════════════════

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Serper API Key (Optional - for real job search)
SERPER_API_KEY=your-serper-api-key-here

# ═══════════════════════════════════════════════════════════════════════════════
# LLM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Model to use (default: gpt-4o)
LLM_MODEL=gpt-4o

# Temperature for standard tasks (default: 0.2)
LLM_TEMPERATURE=0.2

# Temperature for creative tasks like enhancement (default: 0.3)
LLM_TEMPERATURE_CREATIVE=0.3

# ═══════════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Server host (default: 0.0.0.0)
HOST=0.0.0.0

# Server port (default: 5000)
PORT=5000

# Debug mode (default: true)
DEBUG=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════════
# FILE HANDLING
# ═══════════════════════════════════════════════════════════════════════════════

# Upload folder path
UPLOAD_FOLDER=uploads

# Output folder path
OUTPUT_FOLDER=outputs

# Max file size in MB
MAX_CONTENT_LENGTH_MB=16

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,docx

# ═══════════════════════════════════════════════════════════════════════════════
# PROCESSING LIMITS
# ═══════════════════════════════════════════════════════════════════════════════

# Maximum bullets to process in Layer 1
LAYER1_BULLET_LIMIT=10

# Maximum bullets to process in Layer 2
LAYER2_BULLET_LIMIT=8

# Resume preview character limit
RESUME_PREVIEW_CHARS=500

# Number of bullets to show in preview
BULLETS_PREVIEW_COUNT=10

# Maximum verification questions to generate
MAX_VERIFICATION_QUESTIONS=5

# Maximum jobs per role category
MAX_JOBS_PER_ROLE=10

# Maximum total jobs to return
MAX_TOTAL_JOBS=30

# Maximum role suggestions
MAX_ROLE_SUGGESTIONS=6

# ═══════════════════════════════════════════════════════════════════════════════
# ATS SCORING CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Base score for any bullet
ATS_BASE_SCORE=30

# Bonus for including metrics/numbers
ATS_METRICS_BONUS=20

# Bonus for using action verbs
ATS_ACTION_VERB_BONUS=15

# Bonus per technical term matched
ATS_TECH_TERM_BONUS=5

# Maximum bonus from technical terms
ATS_TECH_TERM_BONUS_MAX=25

# Bonus for optimal bullet length
ATS_LENGTH_BONUS=10

# Optimal bullet length range
OPTIMAL_BULLET_LENGTH_MIN=100
OPTIMAL_BULLET_LENGTH_MAX=200

# Score bounds for original resume
ORIGINAL_SCORE_MIN=25
ORIGINAL_SCORE_MAX=65

# Score bounds for enhanced resume
ENHANCED_SCORE_MIN=70
ENHANCED_SCORE_MAX=98

# Layer 2 improvement range
LAYER2_IMPROVEMENT_MIN=5
LAYER2_IMPROVEMENT_MAX=12

# Score multipliers
ORIGINAL_SCORE_MULTIPLIER=0.9
ENHANCED_SCORE_MULTIPLIER=0.95

# ═══════════════════════════════════════════════════════════════════════════════
# ROLE CONFIDENCE THRESHOLDS
# ═══════════════════════════════════════════════════════════════════════════════

# Threshold for "strong" confidence (above this = strong)
ROLE_STRONG_THRESHOLD=85

# Threshold for "borderline" confidence (between this and strong = borderline)
ROLE_BORDERLINE_THRESHOLD=60

# ═══════════════════════════════════════════════════════════════════════════════
# KEYWORD LISTS (comma-separated)
# ═══════════════════════════════════════════════════════════════════════════════

# Action verbs for scoring
ACTION_VERBS=built,designed,developed,led,created,implemented,architected,optimized,delivered,launched,managed,spearheaded,orchestrated,pioneered,transformed,streamlined,automated,engineered,established,executed

# Technical terms for scoring
TECH_TERMS=python,javascript,typescript,java,go,rust,aws,azure,gcp,docker,kubernetes,ml,ai,api,database,cloud,tensorflow,pytorch,langchain,llm,genai,fastapi,react,node,sql,nosql,redis,kafka,spark,airflow,mlops,ci/cd

# Bullet point prefixes to detect
BULLET_PREFIXES=•,-,*,–,►,▪,●

# ═══════════════════════════════════════════════════════════════════════════════
# JOB SEARCH CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Default location for job search
DEFAULT_LOCATION=United States

# Job search recency (days)
JOB_SEARCH_RECENCY_DAYS=7

# Enabled job boards (comma-separated)
ENABLED_JOB_BOARDS=linkedin,indeed,glassdoor,lever,greenhouse

# Use mock data for POC (true = use mock, false = real search)
USE_MOCK_JOB_DATA=true

# Job board search URL templates
LINKEDIN_SEARCH_URL=https://linkedin.com/jobs/search?keywords={query}&location={location}
INDEED_SEARCH_URL=https://indeed.com/jobs?q={query}&l={location}
GLASSDOOR_SEARCH_URL=https://glassdoor.com/Job/{location}-{query}-jobs.htm

# ═══════════════════════════════════════════════════════════════════════════════
# DOCX GENERATION
# ═══════════════════════════════════════════════════════════════════════════════

# Font sizes in points
DOCX_TITLE_FONT_SIZE=14
DOCX_BODY_FONT_SIZE=11
DOCX_SUBTITLE_FONT_SIZE=10

# Highlight enhanced content
DOCX_HIGHLIGHT_ENHANCED=true
